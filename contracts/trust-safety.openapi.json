  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReportReview": {
        "properties": {
          "reviewId": {
            "type": "string",
            "format": "uuid",
            "title": "Reviewid"
          },
          "category": {
            "type": "string",
            "enum": [
              "harassment",
              "unsafe_behaviour",
              "fake_profile",
              "spam",
              "other"
            ],
            "title": "Category"
          },
          "details": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "reviewId",
          "category",
          "details"
        ],
        "title": "ReportReview"
      },
      "ReportRunner": {
        "properties": {
          "runnerId": {
            "type": "string",
            "format": "uuid",
            "title": "Runnerid"
          },
          "category": {
            "type": "string",
            "enum": [
              "harassment",
              "unsafe_behaviour",
              "fake_profile",
              "spam",
              "other"
            ],
            "title": "Category"
          },
          "details": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "runnerId",
          "category",
          "details"
        ],
        "title": "ReportRunner"
      },
      "ResolveReport": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "dismissed",
              "actioned"
            ],
            "title": "Outcome"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "outcome"
        ],
        "title": "ResolveReport"
      },
      "ReviewVerification": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ],
            "title": "Decision"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "ReviewVerification"
      },
      "Suspend": {
        "properties": {
          "runnerId": {
            "type": "string",
            "format": "uuid",
            "title": "Runnerid"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "runnerId",
          "reason"
        ],
        "title": "Suspend"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
